#!/usr/bin/env bash
# 자료 다운로드 + 주차 인덱스 + 요약. 하루 한 번(03:00) 이면 충분하다 —
# 교수가 자료를 올리는 건 하루 단위 사건이고, 받는 것도 요약도 무겁다.
#
# 🔴 이 스크립트만 비용이 든다 (LLM). 새 자료만 요약하고 실행당 상한이 있으며,
#    상한에 걸리거나 실패하면 .progress 에 남아 다음날이 이어받는다.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 0
mkdir -p state
LOG="state/cron.log"
printf '%s ── materials\n' "$(date '+%F %T')" >> "$LOG"
if ./bin/ssu-agent sync >> "$LOG" 2>&1 && ./bin/ssu-agent materials >> "$LOG" 2>&1; then
  # 받은 직후에 요약한다 — "자료가 올라오는 시점"에 가장 가깝다.
  # 🔴 여기서만 돈이 나간다. 새 자료만 처리하고(장부로 판별) 실행당 상한이 있다.
  #    상한에 걸리면 .progress 에 남아 다음날이 이어받는다.
  printf '%s ── summarize\n' "$(date '+%F %T')" >> "$LOG"
  ./bin/ssu-agent summarize >> "$LOG" 2>&1 \
    || printf '%s ✖ summarize 실패 — 장부는 남는다\n' "$(date '+%F %T')" >> "$LOG"
else
  printf '%s ✖ materials 실패 — 요약은 건너뛴다\n' "$(date '+%F %T')" >> "$LOG"
fi
