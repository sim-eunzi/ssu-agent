# cp .env.example .env  후 값만 채운다.
# .env 는 gitignore. vault 에 절대 넣지 않는다 (GitHub 푸시됨).

CANVAS_BASE=https://canvas.ssu.ac.kr

# Canvas 개인 액세스 토큰. 만료 2026-12-31
# 계정 > 설정 > 승인된 통합 > + 새로운 액세스 토큰
CANVAS_TOKEN=

# 텔레그램 설정은 여기 없다. ssu-agent 는 전송하지 않는다 —
# 계산해서 stdout 으로 내놓고, 보내는 건 헤르메스봇이 한다.

# M2(vault 반영) 에서만 쓴다. iMac 기준.
VAULT_PATH=/Users/eunzi/eunzi-os
STUDY_PY=/Users/eunzi/eunzi-tools/bin/study.py

# ── 자료 요약 (summarize) ────────────────────────────────────────
# LLM 은 여기서만 쓴다. 나머지 명령(sync·vault-sync·materials·brief)은
# 키 없이 돌고 의존성도 0 이다.
SUMMARY_PROVIDER=anthropic     # anthropic | openai
ANTHROPIC_API_KEY=             # anthropic 일 때
OPENAI_API_KEY=                # openai 일 때
# 안 적으면 공급자별 기본값 (claude-opus-5 / gpt-5.1).
# `ssu-agent summarize --models` 로 실제 쓸 수 있는 걸 확인하고 고른다.
SUMMARY_MODEL=
SUMMARY_EFFORT=medium          # 사고 깊이. 비용을 가장 크게 가른다
SUMMARY_MAX_CALLS=30           # 실행당 LLM 호출 상한. 넘으면 다음 실행이 이어받는다
SUMMARY_CHUNK_CHARS=40000      # 문서를 이 크기로 쪼갠다
# 비용 어림용 단가($/1M). 안 적으면 공급자 기본값을 쓴다 — 청구서가 아니라 눈대중이다.
SUMMARY_USD_IN=
SUMMARY_USD_OUT=
